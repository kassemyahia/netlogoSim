# Public frontend configuration only. Never put Google credentials or a service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Legacy projects may use this instead of VITE_SUPABASE_PUBLISHABLE_KEY:
# VITE_SUPABASE_ANON_KEY=eyJ...

# Optional public Drive textbook IDs. Leave blank to show “unavailable”.
VITE_BOOK_G7_MATH_ID=
VITE_BOOK_G7_SCIENCE_ID=
VITE_BOOK_G7_PHYSICS_ID=
VITE_BOOK_G8_ALGEBRA_ID=
VITE_BOOK_G8_GEOMETRY_ID=
